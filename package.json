{
  "name": "sharkord-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sharkord desktop client: screen sharing with full PC audio, excluding Sharkord's own playback",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "bun run build && electron .",
    "selftest": "bun run build && electron . --selftest"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
